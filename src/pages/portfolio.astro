---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';

const title = 'Portfolio';
const description = '14 apps and projects by Torstein Skulbru — from private Git hosting, social media automation and analytics dashboards to API monitoring tools and mobile apps for iOS and Android, built with Go, Rust, TypeScript, Swift, and Kotlin.';

const siteURL = 'https://tskulbru.dev';
// JSON-LD only. Keep in sync with the App Store listings (name, genre, platforms, price).
// Sunset or offline products (StartRemoteWork, IssueFlow) are left out on purpose.
const portfolioItems = [
	{ name: 'follow.fast', type: 'WebApplication', description: 'Social media posts made from your real app screens. AI drafts slideshows from your screenshots and push notifications every day, then publishes them to TikTok, Instagram, Facebook, Threads and Bluesky. In private beta.', category: 'BusinessApplication', os: 'Web', url: 'https://follow.fast' },
	{ name: 'Smia', type: 'WebApplication', description: 'Private Git hosting and CI for European companies. A dedicated Forgejo instance per company on European providers, encrypted at rest, with CI jobs running in isolated Firecracker microVMs. In the making, invite-only.', category: 'DeveloperApplication', os: 'Web', url: 'https://smia.dev' },
	{ name: 'PadelIQ', type: 'MobileApplication', description: 'AI match analysis for padel players. Film one rally through the court glass and get a positioning heatmap and three concrete fixes — all computer vision runs on-device, video never leaves the iPhone.', category: 'SportsApplication', os: 'iOS', url: 'https://apps.apple.com/us/app/padeliq-ai-match-analysis/id6796823937', price: '0' },
	{ name: 'Plask', type: 'WebApplication', description: 'A private P&L for makers who run more than one product. Revenue from Stripe, RevenueCat and the app stores next to GA4 traffic, minus ad spend and fixed costs, with up to three weekly Focus cards on the products that need you.', category: 'BusinessApplication', os: 'Web', url: 'https://plask.dev' },
	{ name: 'APIDrift', type: 'WebApplication', description: 'API breaking change alerts and migration guides. Monitors 25+ APIs daily, uses AI to classify changes by severity, and generates step-by-step migration guides.', category: 'DeveloperApplication', os: 'Web', url: 'https://apidrift.dev' },
	{ name: 'Linetris', type: 'MobileApplication', description: 'Daily block puzzle game. Place pieces to clear lines and chain combos in a new puzzle every day.', category: 'GameApplication', os: 'iOS', url: 'https://apps.apple.com/us/app/linetris-daily-block-puzzle/id6759858457', price: '0' },
	{ name: 'Neimr', type: 'MobileApplication', description: 'Baby name matcher for couples. Both parents swipe through names on their own phones, and Neimr shows the names you both like.', category: 'LifestyleApplication', os: 'iOS', url: 'https://apps.apple.com/us/app/neimr-baby-name-matcher/id6758278121', price: '0' },
	{ name: 'BibleWise', type: 'MobileApplication', description: 'Bible quiz game. Test your Biblical knowledge through trivia quizzes with multiple game modes and levels.', category: 'GameApplication', os: 'iOS', url: 'https://apps.apple.com/us/app/biblewise-bible-quiz-game/id6758916009', price: '0' },
	{ name: 'Mockingjay', type: 'MobileApplication', description: 'Secure bodycam app. Records video with real-time AES-256-GCM encryption and encrypted cloud backup, so recordings survive even if the phone is taken.', category: 'MultimediaApplication', os: 'iOS', url: 'https://apps.apple.com/us/app/mockingjay-secure-bodycam/id6758616261', price: '0' },
	{ name: 'GraceLock', type: 'MobileApplication', description: 'Pray before you scroll. Locks distracting apps until you have taken a moment to pray, using Apple Screen Time.', category: 'LifestyleApplication', os: 'iOS', url: 'https://apps.apple.com/us/app/gracelock-pray-screen-time/id6758113098', price: '0' },
	{ name: 'MyVisualRoutine', type: 'MobileApplication', description: 'Visual schedules and choice boards for autistic and ADHD children. Helps kids follow daily routines with picture-based steps.', category: 'HealthApplication', os: 'iOS', url: 'https://myvisualroutine.com', installUrl: 'https://apps.apple.com/us/app/myvisualroutine-autism-adhd/id6757563805', price: '0' },
	{ name: 'BuzzBlast', type: 'MobileApplication', description: 'Turn your iPhone into a quiz game buzzer for group trivia nights.', category: 'EntertainmentApplication', os: 'iOS', url: 'https://apps.apple.com/us/app/buzzblast-quiz-buzzer-app/id6757406066', price: '0' },
	{ name: 'Stao', type: 'SoftwareApplication', description: 'Standing desk reminder. Uses the 20-8-2 pattern to remind you to alternate between sitting, standing and moving.', category: 'HealthApplication', os: ['iOS', 'macOS', 'Android', 'Windows', 'Linux'], url: 'https://www.stao.app/', installUrl: 'https://apps.apple.com/us/app/stao-standing-desk-reminder/id6756825085', price: '2.99' },
	{ name: 'Kvile', type: 'SoftwareApplication', description: 'Lightweight desktop HTTP client built around plain-text .http files. Offline-first, no account, open source. Built with Tauri and Rust.', category: 'DeveloperApplication', os: ['macOS', 'Windows', 'Linux'], url: 'https://kvile.app/', sameAs: 'https://github.com/tskulbru/kvile', price: '0' },
];

const portfolioSchema = {
	"@context": "https://schema.org",
	"@type": "ItemList",
	"name": "Portfolio - Apps and Projects by Torstein Skulbru",
	"description": description,
	"numberOfItems": portfolioItems.length,
	"itemListElement": portfolioItems.map((item, index) => ({
		"@type": "ListItem",
		"position": index + 1,
		"item": {
			"@type": item.type,
			"name": item.name,
			"description": item.description,
			"applicationCategory": item.category,
			"operatingSystem": Array.isArray(item.os) ? item.os.join(', ') : item.os,
			"url": item.url,
			...(item.installUrl && { "installUrl": item.installUrl }),
			...(item.sameAs && { "sameAs": item.sameAs }),
			"author": {
				"@id": `${siteURL}/#person`
			},
			// Only claim a price where one is published; SaaS pricing lives on each product site.
			...(item.price && {
				"offers": {
					"@type": "Offer",
					"price": item.price,
					"priceCurrency": "USD"
				}
			})
		}
	}))
};
---

<Base head={{ title, description }}>
	<script type="application/ld+json" set:html={JSON.stringify(portfolioSchema)} />
	<Section>
		<h1 class="pb-2 pt-6 text-4xl font-bold">Portfolio</h1>
		<p class="text-sm text-gray-600 dark:text-gray-400 pb-8">
			Apps and projects I've built
		</p>

		<!-- follow.fast -->
		<article class="mb-16">
			<div class="border-b border-gray-200 dark:border-gray-700 pb-2 mb-6">
				<h2 class="text-2xl font-bold">follow.fast</h2>
				<p class="text-orange-600 font-medium">Your app screens, turned into posts that post themselves</p>
			</div>

			<!-- Logo and Feature Highlights -->
			<div class="mb-6 p-6 bg-gray-100 dark:bg-gray-800 rounded-xl">
				<div class="flex flex-col md:flex-row items-center gap-6">
					<!-- Logo -->
					<div class="flex-shrink-0">
						<img
							src="/images/portfolio/followfast-icon.png"
							alt="follow.fast logo: two white chevrons on a pink rounded square"
							class="w-24 h-24 rounded-2xl shadow-lg"
						/>
					</div>
					<!-- Feature Highlights -->
					<div class="flex-1 grid grid-cols-2 gap-3 text-sm">
						<div class="flex items-center gap-2">
							<svg class="w-5 h-5 text-orange-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
							</svg>
							<span>Slideshows from real app screens</span>
						</div>
						<div class="flex items-center gap-2">
							<svg class="w-5 h-5 text-orange-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
							</svg>
							<span>Publishes to 5 platforms</span>
						</div>
						<div class="flex items-center gap-2">
							<svg class="w-5 h-5 text-orange-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
							</svg>
							<span>Approve in bulk or autopilot</span>
						</div>
						<div class="flex items-center gap-2">
							<svg class="w-5 h-5 text-orange-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
							</svg>
							<span>Learns which formats work</span>
						</div>
					</div>
				</div>
			</div>

			<!-- Description with Screenshot -->
			<div class="text-sm space-y-4 mb-6">
				<p>
					<span class="font-bold text-orange-600">follow.fast</span> runs social media for apps. Paste an
					App Store link and it pulls in the name, icon, description and screenshots. Every day it drafts
					slideshow posts from the app's real screens and the push notifications the app really sends,
					rendered on a phone in the scene, and publishes them to TikTok, Instagram, Facebook, Threads and
					Bluesky. Approve the queue with one click, or switch on autopilot.
				</p>
				<p>
					I built it because I ship apps and never had time to post about them. It has posted daily for
					four of my own apps since October 2026, across twelve slideshow formats: persona stories,
					notification stories, listicles, myth vs fact and more. Formats that beat the median get picked
					more often and the rest get retired. Any slide can be edited before it goes out, and the 4:5 feed
					and 9:16 TikTok versions update together. Currently in private beta.
				</p>
				<img
					src="/images/portfolio/followfast-hero.png"
					alt="follow.fast landing page: &quot;Your app screens, turned into posts that post themselves&quot;, above a fan of real slideshow posts for BibleWise, Mockingjay and MyVisualRoutine"
					class="w-full rounded-xl shadow-lg border border-gray-200 dark:border-gray-700"
					loading="lazy"
				/>
			</div>

			<!-- Tech Stack -->
			<div class="mb-6">
				<h3 class="text-sm font-bold mb-2 text-gray-600 dark:text-gray-400">Built with</h3>
				<div class="flex flex-wrap gap-2">
					<span class="px-3 py-1 text-xs rounded-full bg-gray-200 dark:bg-gray-700">Next.js 16</span>
					<span class="px-3 py-1 text-xs rounded-full bg-gray-200 dark:bg-gray-700">React 19</span>
					<span class="px-3 py-1 text-xs rounded-full bg-gray-200 dark:bg-gray-700">TypeScript</span>
					<span class="px-3 py-1 text-xs rounded-full bg-gray-200 dark:bg-gray-700">Postgres</span>
					<span class="px-3 py-1 text-xs rounded-full bg-gray-200 dark:bg-gray-700">Drizzle ORM</span>
					<span class="px-3 py-1 text-xs rounded-full bg-gray-200 dark:bg-gray-700">pg-boss</span>
					<span class="px-3 py-1 text-xs rounded-full bg-gray-200 dark:bg-gray-700">Playwright</span>
					<span class="px-3 py-1 text-xs rounded-full bg-gray-200 dark:bg-gray-700">Claude AI</span>
					<span class="px-3 py-1 text-xs rounded-full bg-gray-200 dark:bg-gray-700">Stripe</span>
					<span class="px-3 py-1 text-xs rounded-full bg-gray-200 dark:bg-gray-700">Cloudflare R2</span>
				</div>
			</div>

			<!-- Platforms -->
			<div class="mb-6">
				<h3 class="text-sm font-bold mb-2 text-gray-600 dark:text-gray-400">Platforms</h3>
				<div class="flex flex-wrap gap-2">
					<span class="px-3 py-1 text-xs rounded-full bg-orange-100 dark:bg-orange-900 text-orange-700 dark:text-orange-300">Web</span>
					<span class="px-3 py-1 text-xs rounded-full bg-orange-100 dark:bg-orange-900 text-orange-700 dark:text-orange-300">SaaS</span>
				</div>
			</div>

			<!-- Links -->
			<div class="flex flex-wrap gap-4">
				<a
					href="https://follow.fast"
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg bg-gray-900 dark:bg-white text-white dark:text-gray-900 hover:bg-orange-600 dark:hover:bg-orange-600 dark:hover:text-white transition-colors"
				>
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
					</svg>
					Visit follow.fast
				</a>
			</div>
		</article>

		<!-- Smia -->
		<article class="mb-16">
			<div class="border-b border-gray-200 dark:border-gray-700 pb-2 mb-6">
				<h2 class="text-2xl font-bold">Smia</h2>
				<p class="text-orange-600 font-medium">Your company's Git &amp; CI. Here in Europe.</p>
			</div>

			<!-- App Icon and Feature Highlights -->
			<div class="mb-6 p-6 bg-gray-100 dark:bg-gray-800 rounded-xl">
				<div class="flex flex-col md:flex-row items-center gap-6">
					<!-- App Icon -->
					<div class="flex-shrink-0">
						<img
							src="/images/portfolio/smia-icon.png"
							alt="Smia icon: a dwarf smith with crossed forge hammers"
							class="w-24 h-24 rounded-2xl shadow-lg"
						/>
					</div>
					<!-- Feature Highlights -->
					<div class="flex-1 grid grid-cols-2 gap-3 text-sm">
						<div class="flex items-center gap-2">
							<svg class="w-5 h-5 text-orange-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
							</svg>
							<span>Dedicated instance per company</span>
						</div>
						<div class="flex items-center gap-2">
							<svg class="w-5 h-5 text-orange-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
							</svg>
							<span>Hosted in the EU or Norway</span>
						</div>
						<div class="flex items-center gap-2">
							<svg class="w-5 h-5 text-orange-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
							</svg>
							<span>Isolated microVM CI jobs</span>
						</div>
						<div class="flex items-center gap-2">
							<svg class="w-5 h-5 text-orange-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
							</svg>
							<span>Backups you hold the key to</span>
						</div>
					</div>
				</div>
			</div>

			<!-- Description with Screenshot -->
			<div class="text-sm space-y-4 mb-6">
				<img
					src="/images/portfolio/smia-hero.png"
					alt="A repository on a Smia forge: file tree, commit messages and a green CI check on the latest commit"
					class="float-right ml-4 mb-4 w-48 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700"
				/>
				<p>
					<span class="font-bold text-orange-600">Smia</span> (Norwegian for "the forge") is managed,
					private Git hosting and CI for European companies. Each company gets its own Forgejo
					instance on its own VM, hosted by European providers with the EU or Norway as the location,
					encrypted at rest, and priced per company rather than per seat. It started with a question
					I kept hearing in security questionnaires: where does our source code live, and who
					operates the platform? An EU region on a US platform answers the first half only.
				</p>
				<p>
					The parts I build sit around an unmodified Forgejo: a Rust runner that boots a fresh
					Firecracker microVM for every CI job and destroys it afterwards, a Go control plane that
					provisions, backs up, restore-tests and offboards instances, and per-company backup keys so a
					customer's history opens with their key, not ours. Smia runs on Smia: its own source code
					and CI live on the forge it sells. Currently in the making and invite-only.
				</p>
			</div>

			<!-- Tech Stack -->
			<div class="mb-6">
				<h3 class="text-sm font-bold mb-2 text-gray-600 dark:text-gray-400">Built with</h3>
				<div class="flex flex-wrap gap-2">
					<span class="px-3 py-1 text-xs rounded-full bg-gray-200 dark:bg-gray-700">Forgejo</span>
					<span class="px-3 py-1 text-xs rounded-full bg-gray-200 dark:bg-gray-700">Go</span>
					<span class="px-3 py-1 text-xs rounded-full bg-gray-200 dark:bg-gray-700">Rust</span>
					<span class="px-3 py-1 text-xs rounded-full bg-gray-200 dark:bg-gray-700">Firecracker</span>
					<span class="px-3 py-1 text-xs rounded-full bg-gray-200 dark:bg-gray-700">KVM</span>
					<span class="px-3 py-1 text-xs rounded-full bg-gray-200 dark:bg-gray-700">OpenTofu</span>
					<span class="px-3 py-1 text-xs rounded-full bg-gray-200 dark:bg-gray-700">Caddy</span>
					<span class="px-3 py-1 text-xs rounded-full bg-gray-200 dark:bg-gray-700">Stripe</span>
					<span class="px-3 py-1 text-xs rounded-full bg-gray-200 dark:bg-gray-700">bunny.net</span>
				</div>
			</div>

			<!-- Platforms -->
			<div class="mb-6">
				<h3 class="text-sm font-bold mb-2 text-gray-600 dark:text-gray-400">Platforms</h3>
				<div class="flex flex-wrap gap-2">
					<span class="px-3 py-1 text-xs rounded-full bg-orange-100 dark:bg-orange-900 text-orange-700 dark:text-orange-300">Web</span>
				</div>
			</div>

			<!-- Links -->
			<div class="flex flex-wrap gap-4">
				<a
					href="https://smia.dev"
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg bg-gray-900 dark:bg-white text-white dark:text-gray-900 hover:bg-orange-600 dark:hover:bg-orange-600 dark:hover:text-white transition-colors"
				>
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
					</svg>
					Visit smia.dev
				</a>
			</div>
		</article>

		<!-- PadelIQ -->
		<article class="mb-16">
			<div class="border-b border-gray-200 dark:border-gray-700 pb-2 mb-6">
				<h2 class="text-2xl font-bold">PadelIQ</h2>
				<p class="text-orange-600 font-medium">Film a rally. Fix your game.</p>
			</div>

			<!-- App Icon and Feature Highlights -->
			<div class="mb-6 p-6 bg-gray-100 dark:bg-gray-800 rounded-xl">
				<div class="flex flex-col md:flex-row items-center gap-6">
					<!-- App Icon -->
					<div class="flex-shrink-0">
						<img
							src="/images/portfolio/padeliq-icon.png"
							alt="PadelIQ app icon"
							class="w-24 h-24 rounded-2xl shadow-lg"
						/>
					</div>
					<!-- Feature Highlights -->
					<div class="flex-1 grid grid-cols-2 gap-3 text-sm">
						<div class="flex items-center gap-2">
							<svg class="w-5 h-5 text-orange-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
							</svg>
							<span>On-device computer vision</span>
						</div>
						<div class="flex items-center gap-2">
							<svg class="w-5 h-5 text-orange-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
							</svg>
							<span>Positioning heatmaps</span>
						</div>
						<div class="flex items-center gap-2">
							<svg class="w-5 h-5 text-orange-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
							</svg>
							<span>Numbers-backed verdicts</span>
						</div>
						<div class="flex items-center gap-2">
							<svg class="w-5 h-5 text-orange-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
							</svg>
							<span>Drills for your weaknesses</span>
						</div>
					</div>
				</div>
			</div>

			<!-- Description with Screenshot -->
			<div class="text-sm space-y-4 mb-6">
				<img
					src="/images/portfolio/padeliq-hero.png"
					alt="PadelIQ results screen showing a court positioning heatmap, stats and a coaching verdict"
					class="float-right ml-4 mb-4 w-48 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700"
				/>
				<p>
					<span class="font-bold text-orange-600">PadelIQ</span> turns the phone-against-the-glass
					footage padel players already record into coaching. Film one rally, and within a minute you
					get a positioning heatmap for every player, stats like time at net and how often the middle
					was left open, and a verdict with the top three things to fix — each one citing numbers from
					your own clip, never generic advice.
				</p>
				<p>
					The entire computer vision pipeline — player detection with YOLOv8 on Core ML, court
					homography, tracking and statistics — runs on the iPhone. Footage never leaves the device;
					only the measured numbers are sent to an LLM to word the verdict like a coach would.
					Detected weaknesses map to a library of 38 drills, and a progress view tracks how the
					numbers move over time.
				</p>
			</div>

			<!-- Tech Stack -->
			<div class="mb-6">
				<h3 class="text-sm font-bold mb-2 text-gray-600 dark:text-gray-400">Built with</h3>
				<div class="flex flex-wrap gap-2">
					<span class="px-3 py-1 text-xs rounded-full bg-gray-200 dark:bg-gray-700">SwiftUI</span>
